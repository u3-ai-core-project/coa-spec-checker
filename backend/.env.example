# 실행 환경: development(기본) | production
# production 이면 JWT_SECRET 이 기본값(change-me)이거나 32자보다 짧을 때 서버가 시작되지 않는다
APP_ENV=development
DATABASE_URL=postgresql+psycopg://coa:coa@localhost:5432/coa
# 토큰 서명용 비밀키. 운영에서는 반드시 바꾼다. 만들기: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
LOW_CONFIDENCE_THRESHOLD=0.8
UPLOAD_DIR=storage/uploads

# ---- 판정 정책 (API 명세 v1.4). 비워 두면 기본값(멘토님 판정표 기준) ----
# 사유코드별 판정 덮어쓰기 (undetermined | check). 예: REASON_JUDGEMENT={"SPEC_COPIED": "check"}
REASON_JUDGEMENT={}
# 검출 안 됨: 검출한계 == 사내 상한이면 적합(true) / 미만이어야 적합(false)
ND_LIMIT_INCLUSIVE=true
# 사내 규격에 없는 AI 추정 항목명: check(확인 필요, 기본) | reference(참고)
UNMAPPED_AI_ITEM=check
# 켤 교차 규칙 (JSON 목록). 사용 가능: heavy_metal_total, na_k_sum
CROSS_RULES=["heavy_metal_total", "na_k_sum"]

# 추출기: mock(목업 JSON) 또는 ai(ai/ 패키지 필요, README 8번 참고)
EXTRACTOR=mock
# 공급사 문의 초안: template(기본) 또는 ai(LLM 서버 필요, 실패하면 템플릿으로 대체)
INQUIRY_DRAFTER=template
# LLM 서버 주소 (ai/README.md 'LLM 기능' 참고, 예: http://127.0.0.1:8090). 비워 두면 LLM 없이 동작
LLM_BASE_URL=

# ---- 처리 실패·재시도 (운영 정책 4장) ----
# 추출 1회 제한 시간(초). 넘으면 실패로 처리
EXTRACTION_TIMEOUT_SEC=300
# 일시 오류일 때 자동으로 다시 시도하는 횟수 (정책: 1~2회)
EXTRACTION_AUTO_RETRIES=1
# 서버를 켤 때 멈춘 문서를 다시 시작할지 (false: 실패로만 정리, true: 시도 상한 안의 문서는 다시 시작) 와 시도 상한
RESUME_STUCK_ON_START=false
MAX_EXTRACTION_ATTEMPTS=2
