# 실행 환경: development(기본) | production
# production 이면 JWT_SECRET 이 기본값(change-me)이거나 32자보다 짧을 때 서버가 시작되지 않는다
APP_ENV=development
DATABASE_URL=postgresql+psycopg://coa:coa@localhost:5432/coa
# 토큰 서명용 비밀키. 운영에서는 반드시 바꾼다. 만들기: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
# 로그인 잠금: 비밀번호를 연속 몇 번 틀리면 몇 분 동안 잠글지
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# 접속 IP 를 X-Forwarded-For 헤더에서 읽을지 (nginx 등 프록시 뒤에서만 true. 프록시 없이 켜면 IP 를 꾸밀 수 있음)
TRUST_PROXY_HEADERS=false
# 로그 (운영 정책 3장): false 면 예외는 종류·위치만 남긴다 (문서 내용·개인정보가 섞이지 않게).
# 개발 중 원인을 자세히 볼 때만 true (전체 traceback). 운영(production)에서는 켜지 않는다
LOG_DEBUG_DETAIL=false
LOW_CONFIDENCE_THRESHOLD=0.8
UPLOAD_DIR=storage/uploads
# ---- 자동 정리·방치 문서 (운영 정책 1장). 서버 1대 운영 전제 ----
# 켜면 서버가 시작 1분 뒤 한 번, 그 뒤로 CLEANUP_INTERVAL_HOURS 마다(기본 24시간 = 하루 한 번) 정리한다
CLEANUP_ENABLED=true
CLEANUP_INTERVAL_HOURS=24
# 추출 실패 후 며칠 지나면 자동 삭제 / 연결 안 된 업로드 파일을 몇 시간 뒤 자동 삭제
FAILED_RETENTION_DAYS=7
ORPHAN_FILE_HOURS=24
# 처분 전 문서가 며칠 동안 활동이 없으면 방치로 표시 / 그 뒤 며칠 더 그대로면 관리자 목록
STALE_DAYS=30
STALE_GRACE_DAYS=7
# 처분 완료 문서 보관 기간(년). 처분일부터 센다. 바꾸면 이후 처분 문서부터 적용 (운영 정책 1장)
RETENTION_YEARS=3
# 보관 기간이 지난 처분 완료 원본을 옮길 폴더 (삭제하지 않고 이동만 함)
ARCHIVE_DIR=storage/archive
# 저장 공간 한도(GB). 업로드 폴더만 센다 (보관용 폴더 제외). 80% 경고, 95% 에서 새 업로드 차단 (운영 정책 1장)
# 서버에 배정한 디스크 크기에 맞춘다. 기본 100GB = CoA 1MB·하루 100건 기준 약 2.5년치
STORAGE_LIMIT_GB=100
STORAGE_WARN_PERCENT=80
STORAGE_BLOCK_PERCENT=95
# 안전장치: 업로드 폴더가 있는 디스크의 실제 남은 공간이 이보다 적으면(GB), STORAGE_LIMIT_GB 와 상관없이 업로드 차단. 0 이면 끔
MIN_FREE_DISK_GB=2
# 같은 파일을 다시 올리면 경고하고(409 DUPLICATE_FILE) 확인(confirm_duplicate=true) 뒤에만 접수. false 면 경고 안 함
DUPLICATE_FILE_CHECK=true
# ---- 업로드·요청 크기 (운영 정책 3장) ----
# 파일 하나 상한(MB) / 일괄 접수 한 번에 올릴 CoA 수
MAX_UPLOAD_MB=20
MAX_BATCH_FILES=20
# 업로드가 아닌 모든 요청(JSON 등)의 본문 상한(KB). 넘으면 413 REQUEST_TOO_LARGE
MAX_REQUEST_KB=1024
# 업로드 요청에서 파일 말고 붙는 부분(멀티파트 경계·폼 값)에 주는 여유(KB).
# 요청 상한 = 단건 MAX_UPLOAD_MB + 여유, 일괄 MAX_UPLOAD_MB × (MAX_BATCH_FILES + 입고 CSV 1개) + 여유
UPLOAD_FORM_OVERHEAD_KB=1024

# ---- 판정 정책 (API 명세 v1.4). 비워 두면 기본값(멘토님 판정표 기준) ----
# 사유코드별 판정 덮어쓰기 (undetermined | check). 예: REASON_JUDGEMENT={"SPEC_COPIED": "check"}
REASON_JUDGEMENT={}
# 검출 안 됨: 검출한계 == 사내 상한이면 적합(true) / 미만이어야 적합(false)
ND_LIMIT_INCLUSIVE=true
# 사내 규격에 없는 AI 추정 항목명: check(확인 필요, 기본) | reference(참고)
UNMAPPED_AI_ITEM=check
# 켤 교차 규칙 (JSON 목록). 사용 가능: heavy_metal_total, na_k_sum
CROSS_RULES=["heavy_metal_total", "na_k_sum"]

# 추출기: mock(목업 JSON) 또는 ai(ai/ 패키지 필요, README 8번 참고)
EXTRACTOR=mock
# 공급사 문의 초안: template(기본) 또는 ai(LLM 서버 필요, 실패하면 템플릿으로 대체)
INQUIRY_DRAFTER=template
# LLM 서버 주소 (ai/README.md 'LLM 기능' 참고, 예: http://127.0.0.1:8090). 비워 두면 LLM 없이 동작
LLM_BASE_URL=

# ---- 처리 실패·재시도 (운영 정책 4장) ----
# 추출 1회 제한 시간(초). 넘으면 실패로 처리
EXTRACTION_TIMEOUT_SEC=300
# 일시 오류일 때 자동으로 다시 시도하는 횟수 (정책: 1~2회)
EXTRACTION_AUTO_RETRIES=1
# 서버를 켤 때 멈춘 문서를 다시 시작할지 (false: 실패로만 정리, true: 시도 상한 안의 문서는 다시 시작) 와 시도 상한
RESUME_STUCK_ON_START=false
MAX_EXTRACTION_ATTEMPTS=2
